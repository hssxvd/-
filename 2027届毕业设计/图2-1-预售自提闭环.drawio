          <mxGeometry x="115" y="120" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- arrow -->
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="窗口内预售下单
consumer join → 写 group_buy_member
只存 member 记录，不生成订单
选自提点 pickup_point_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2n" value="②" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="375" y="120" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="cycle_end 到期" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="560" y="190" as="sourcePoint" />
            <mxPoint x="590" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="窗口关闭 settleWindowEnd
自动检查 member → 批量生成 orders
activity.status → CLOSED
无人下单 → CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3n" value="③" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="705" y="120" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="商家一键配货 POST /{id}/ready
