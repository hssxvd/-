<mxfile host="app.diagrams.net" modified="2026-11-03T00:00:00.000Z" agent="Trae" version="24.0.0">
  <diagram id="flow" name="图2-1 预售自提闭环流程图">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Step 1 -->
        <mxCell id="s1" value="商家创建预售活动
设置窗口 cycle_start ~ cycle_end
+ 自提点 + SKU + 目标销量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
