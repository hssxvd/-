          <mxGeometry x="700" y="500" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_refunded" value="REFUNDED
原路退回" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c_a1" value="申请退款" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="c_init" target="c_pending">
