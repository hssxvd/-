          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_a2" value="POST /{id}/ready" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="b_assign" target="b_pickup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="b_a3" value="POST /pickup/fulfillment
核销成功" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="b_pickup" target="b_done">
          <mxGeometry relative="1" as="geometry" />
