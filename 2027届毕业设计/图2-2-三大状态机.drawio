<mxfile host="app.diagrams.net" modified="2026-11-03T00:00:00.000Z" agent="Trae" version="24.0.0">
  <diagram id="state" name="图2-2 三大状态机">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ====== A. 团购活动状态机 ====== -->
        <mxCell id="title_a" value="A. 团购活动状态机" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="a_open" value="OPEN
预售中" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="90" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_closed" value="CLOSED
窗口关 / 等配货" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="90" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_completed" value="COMPLETED
全部核销" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_cancelled" value="CANCELLED
手动关 / 无人下单" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- arrows A -->
        <mxCell id="a_arc1" value="cycle_end 到期
有人下单" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="a_open" target="a_closed">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="310" y="120" as="sourcePoint" />
            <mxPoint x="350" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a_arc2" value="全部 orders COMPLETED" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_closed" target="a_completed">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a_arc3" value="cycle_end 到期
无人下单 OR 商家手动关" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_open" target="a_cancelled">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="220" y="180" as="sourcePoint" />
            <mxPoint x="870" y="180" as="targetPoint" />
            <Array as="points">
              <mxPoint x="220" y="180" />
              <mxPoint x="220" y="200" />
              <mxPoint x="870" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ====== B. 订单履约状态机 ====== -->
        <mxCell id="title_b" value="B. 订单履约状态机（fulfillment_status）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="380" height="30" as="geometry" />
        </mxCell>

        <mxCell id="b_pay" value="PENDING_PAY" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_assign" value="PENDING_ASSIGN
